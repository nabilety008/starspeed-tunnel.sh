#!/usr/bin/env bash
# Minimal fake HAProxy used by the test suite.
#
# -c   : validate the config. Fails if the file contains an `include` line
#        (HAProxy has no include keyword in ANY section: `include` always comes
#        back as an unknown keyword, exactly like the real 3.2 parser), if a
#        keyword appears before the first section, if the file contains the
#        marker string FAILVALIDATE, or if it references an unknown "bind" port
#        that the test marked as forbidden.
# --version / -v : report a version.
set -uo pipefail

FAKE_FORBIDDEN_PORTS=${FAKE_HAPROXY_FORBIDDEN_PORTS:-}

if [[ ${1:-} == "--version" || ${1:-} == "-v" ]]; then
  echo "HAProxy fake 3.2-test"
  exit 0
fi

validate=0
cfg=""
while (( $# )); do
  case $1 in
    -c|--check) validate=1; shift ;;
    -f) cfg=$2; shift 2 ;;
    *) shift ;;
  esac
done

if (( validate == 0 )); then
  echo "fake haproxy: only -c/-f is supported in this test stub" >&2
  exit 2
fi

[[ -n $cfg && -f $cfg ]] || { echo "[ALERT] config file not found: $cfg" >&2; exit 1; }

if grep -q 'FAILVALIDATE' "$cfg"; then
  echo "[ALERT] parse error near 'FAILVALIDATE' in $cfg" >&2
  exit 1
fi

# Walk the file the way the real parser does: sections are sticky (a section
# only ends on the next section keyword or on end of file), comments and blank
# lines are delimiters, and a keyword is only legal once a section has started.
# `include` is not a keyword anywhere, so it is rejected in every context with
# the same messages the real binary emits.
section=""
lineno=0
fatal=0
while IFS= read -r line || [[ -n $line ]]; do
  lineno=$((lineno + 1))
  # Strip leading whitespace; HAProxy does not care about indentation.
  trimmed=${line#"${line%%[![:space:]]*}"}
  [[ -z $trimmed || $trimmed == \#* ]] && continue
  kw=${trimmed%%[[:space:]]*}

  if [[ $kw == include ]]; then
    if [[ -z $section ]]; then
      echo "[ALERT] parsing [$cfg:$lineno] : unknown keyword 'include' out of section." >&2
    else
      echo "[ALERT] parsing [$cfg:$lineno] : unknown keyword 'include' in '$section' section" >&2
    fi
    fatal=1
    continue
  fi

  # A section keyword opens (or re-opens) a section and is legal anywhere,
  # including as the very first line of the file.
  case $kw in
    global|defaults|frontend|backend|listen|cache|program|peers|resolvers|mailers|fcgi-app|log-forward|userlist)
      section=$kw
      continue
      ;;
  esac

  if [[ -z $section ]]; then
    echo "[ALERT] parsing [$cfg:$lineno] : unknown keyword '$kw' out of section." >&2
    fatal=1
    continue
  fi
done <"$cfg"

if (( fatal )); then
  echo "Fatal errors found in configuration." >&2
  exit 1
fi

if [[ -n $FAKE_FORBIDDEN_PORTS ]]; then
  for p in ${FAKE_FORBIDDEN_PORTS//,/ }; do
    if grep -Eq "bind[[:space:]]+(0\.0\.0\.0|\*):${p}([[:space:]]|\$)" "$cfg"; then
      echo "[ALERT] cannot bind socket [0.0.0.0:${p}]" >&2
      exit 1
    fi
  done
fi

echo "Configuration file is valid"
exit 0
