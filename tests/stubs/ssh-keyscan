#!/usr/bin/env bash
# Minimal fake ssh-keyscan used by the test suite.
# Prints a deterministic fake public host key for the requested host/port.
set -uo pipefail
port=''
while (( $# )); do
  case $1 in
    -p) port=$2; shift 2 ;;
    -T) shift 2 ;;
    -H) shift ;;
    -*) shift ;;
    *) shift ;;   # the host; not needed to build a deterministic fake key
  esac
done

if [[ ${FAKE_KEYSCAN_FAIL:-0} == 1 ]]; then
  exit 1
fi

echo "${FAKE_KEYSCAN_HOST:-203.0.113.10} ${port:-22} ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFakeHostKeyForTestingOnly0000000000"
exit 0